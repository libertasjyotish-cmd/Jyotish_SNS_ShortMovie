# Public origin of this deployment, used to build the Creatomate webhook URL
PUBLIC_BASE_URL=https://example.vercel.app

# Google Sheets (MasterDB)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

# Gemini (script generation)
GEMINI_API_KEY=

# Creatomate (video rendering)
CREATOMATE_API_KEY=
# Shared secret appended to the render webhook URL (?secret=...)
CREATOMATE_WEBHOOK_SECRET=
# Optional override, defaults to https://api.creatomate.com/v2/renders
CREATOMATE_RENDERS_ENDPOINT=

# Protects /api/cron/* (Vercel Cron sends it as `Authorization: Bearer <value>`)
CRON_SECRET=

# Fallback YouTube OAuth client; per-language clients can be set in the Channels
# sheet (youtube_client_id / youtube_client_secret) to split the upload quota.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# private | unlisted | public — keep `private` until the pipeline is verified
YOUTUBE_PRIVACY_STATUS=private

# SELF_ONLY | PUBLIC_TO_EVERYONE — unaudited TikTok apps can only post SELF_ONLY
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Also share the Reel to the Instagram feed
INSTAGRAM_SHARE_TO_FEED=true
