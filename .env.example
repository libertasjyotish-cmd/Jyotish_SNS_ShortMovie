# Public origin of this deployment, used to build the Creatomate webhook URL
PUBLIC_BASE_URL=https://example.vercel.app

# Google Sheets (MasterDB)
# Paste the downloaded service account key file verbatim (preferred),
# or set GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_PRIVATE_KEY instead.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

# Gemini (script generation)
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=
# Optional batching knobs for /api/cron/weekly-generate (defaults: 4 / 35000).
WEEKLY_GENERATE_CONCURRENCY=
WEEKLY_GENERATE_BUDGET_MS=

# Creatomate (video rendering)
CREATOMATE_API_KEY=
# Shared secret appended to the render webhook URL (?secret=...)
CREATOMATE_WEBHOOK_SECRET=
# Optional override, defaults to https://api.creatomate.com/v2/renders
CREATOMATE_RENDERS_ENDPOINT=

# Vercel Blob store that hosts the generated narration MP3s
BLOB_READ_WRITE_TOKEN=

# Google Cloud Text-to-Speech (uses the same service account as Sheets).
# Optional per-language overrides; defaults are set in src/services/tts.ts.
TTS_LANGUAGE_CODE_JA=
TTS_VOICE_JA=
TTS_LANGUAGE_CODE_EN=
TTS_VOICE_EN=
TTS_LANGUAGE_CODE_ES=
TTS_VOICE_ES=
TTS_LANGUAGE_CODE_PT=
TTS_VOICE_PT=
TTS_LANGUAGE_CODE_ID=
TTS_VOICE_ID=
TTS_LANGUAGE_CODE_AR=
TTS_VOICE_AR=

# Protects /api/cron/* (Vercel Cron sends it as `Authorization: Bearer <value>`)
CRON_SECRET=

# Cloud Run ffmpeg renderer; renders go through Creatomate while this is unset
RENDERER_URL=

# Fallback YouTube OAuth client; per-language clients can be set in the Channels
# sheet (youtube_client_id / youtube_client_secret) to split the upload quota.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# private | unlisted | public — keep `private` until the pipeline is verified
YOUTUBE_PRIVACY_STATUS=private

# TikTok app credentials; per-account tokens are refreshed into the Channels sheet
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# SELF_ONLY | PUBLIC_TO_EVERYONE — unaudited TikTok apps can only post SELF_ONLY
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Also share the Reel to the Instagram feed
INSTAGRAM_SHARE_TO_FEED=true
